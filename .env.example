VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: enables Sentry error tracking in production builds. Leave unset
# in local development — the app runs identically without it. See
# docs/deployment.md for how to create a Sentry project and DSN.
VITE_SENTRY_DSN=
